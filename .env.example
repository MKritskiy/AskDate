DOCKER_REGISTRY=
DB_PASSWORD=YourSecureDatabasePassword
JWT_KEY=YourSuperSecretKeyMinimum32Characters!
JWT_ISSUER=AskDateIssuer
JWT_AUDIENCE=AskDateAudience
# Комма-разделённый список email, которые получают роль Administrator при старте users.web.
# Работает и на сервере с существующей БД (idempotent). Пример: ADMIN_EMAIL=me@example.com
ADMIN_EMAIL=
# Общий секрет для межсервисных вызовов (askdate.web -> users.web). Одинаковое значение у обоих сервисов.
INTERNAL_API_KEY=ChangeMeInternalKey123456
